    <qresource prefix="/styles">
        <file>styles.qss</file>
    </qresource>
    <qresource prefix="/scripts">
        <file alias="check_tethering.ps1">scripts/check_tethering.ps1</file>
        <file alias="start_tethering.ps1">scripts/start_tethering.ps1</file>
        <file alias="stop_tethering.ps1">scripts/stop_tethering.ps1</file>
        <file alias="tethering_state.ps1">scripts/tethering_state.ps1</file>
        <file alias="hotspot_ip.ps1">scripts/hotspot_ip.ps1</file>
    </qresource>
</RCC>
